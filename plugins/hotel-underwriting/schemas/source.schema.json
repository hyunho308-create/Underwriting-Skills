{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hotel-underwriting/schemas/source.schema.json",
  "title": "Hotel underwriting source",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "project_id",
    "source_kind",
    "location",
    "captured_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{16}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "source_kind": {"enum": ["local_file", "web_page", "database_result", "other"]},
    "location": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["relative_path", "url", "external_id"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version_token": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "supersedes_source_id": {"type": "string", "pattern": "^src_[a-f0-9]{16}$"},
    "document_type": {"type": "string", "minLength": 1},
    "availability": {"enum": ["available", "missing", "inaccessible"]},
    "metadata": {"type": "object", "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
