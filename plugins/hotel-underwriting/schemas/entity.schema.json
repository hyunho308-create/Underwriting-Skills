{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hotel-underwriting/schemas/entity.schema.json",
  "title": "Hotel underwriting entity",
  "type": "object",
  "required": ["schema_version", "entity_id", "project_id", "entity_type", "name"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{16}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "entity_type": {"enum": ["hotel"]},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
