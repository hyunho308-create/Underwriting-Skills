{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hotel-underwriting/schemas/project.schema.json",
  "title": "Hotel underwriting project",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "name",
    "deal_room_root",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "deal_room_root": {"const": "."},
    "primary_property_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
